<mxCell id="title" value="&lt;b&gt;System architecture: Android app with Explorer and Venue roles (MVVM + Firebase/Google)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="180" y="5" width="900" height="30" as="geometry"/></mxCell>
