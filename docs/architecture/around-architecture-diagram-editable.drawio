<mxfile host="app.diagrams.net"><diagram id="arch" name="System architecture"><mxGraphModel dx="1200" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1155" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;System architecture: Android app with Explorer and Venue roles (MVVM + Firebase/Google)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="180" y="5" width="1020" height="30" as="geometry"/></mxCell>
<mxCell id="viewL" value="View: Jetpack Compose screens" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="65" width="1105" height="224" as="geometry"/></mxCell>
<mxCell id="exp" value="&lt;b&gt;Explorer app&lt;/b&gt; (bottom nav: Quests, Map, Profile)&lt;br&gt;Map: quest and venue pins, nearby quest pager,&lt;br&gt;filters, location banner; venue page with&lt;br&gt;quest detail sheet; profile with sign-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="viewL"><mxGeometry x="15" y="32" width="408" height="180" as="geometry"/></mxCell>
<mxCell id="expP" value="&lt;i&gt;Planned:&lt;/i&gt; quest list (the Quests tab is a &quot;Coming soon&quot; stub), companion queue, party chat, ranked matches, reservation, proof, result, my quests, offline queue, leaderboard, friends, posts, rank rewards" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="exp"><mxGeometry x="12" y="94" width="384" height="76" as="geometry"/></mxCell>
<mxCell id="gate" value="&lt;b&gt;Login and role gate&lt;/b&gt;&lt;br&gt;Sign-in (email, Google), registration with role choice; opens the Explorer or Venue app for the saved role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;" vertex="1" parent="viewL"><mxGeometry x="443" y="32" width="220" height="95" as="geometry"/></mxCell>
<mxCell id="ven" value="&lt;b&gt;Venue app&lt;/b&gt; (bottom nav: Dashboard, Quests, Profile)&lt;br&gt;Venue entry: loads the owner's venue, or runs&lt;br&gt;venue setup (name, then area on a map with&lt;br&gt;address search); Quests tab opens the create-quest&lt;br&gt;form (rewards, radius map); profile with sign-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="viewL"><mxGeometry x="683" y="32" width="407" height="180" as="geometry"/></mxCell>
<mxCell id="venP" value="&lt;i&gt;Planned:&lt;/i&gt; dashboard (the Dashboard tab is a &quot;Coming soon&quot; stub), venue's quest list and editing, slot settings, reservation inbox, upcoming visits, review queue, past reviews, completion stats, ratings, business profile" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="ven"><mxGeometry x="12" y="94" width="383" height="76" as="geometry"/></mxCell>
<mxCell id="recv" value="&lt;b&gt;Push receiver&lt;/b&gt; (planned)&lt;br&gt;Firebase messaging service; notifies both apps" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="vmL" value="ViewModel (StateFlow)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="325" width="1105" height="162" as="geometry"/></mxCell>
<mxCell id="expVM" value="&lt;b&gt;Explorer ViewModels&lt;/b&gt;&lt;br&gt;MapViewModel (pins, nearby filters, location),&lt;br&gt;VenuePageViewModel (venue page, quest sheet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="vmL"><mxGeometry x="15" y="32" width="408" height="118" as="geometry"/></mxCell>
<mxCell id="expVMP" value="&lt;i&gt;Planned:&lt;/i&gt; QuestListVM, RatingVM, QueueVM, ChatVM, ReserveVM, ProofVM, MyQuestsVM, RankVM, FriendsVM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="expVM"><mxGeometry x="12" y="60" width="384" height="48" as="geometry"/></mxCell>
<mxCell id="authVM" value="&lt;b&gt;Shared by both apps&lt;/b&gt;&lt;br&gt;AuthViewModel&lt;br&gt;SessionViewModel&lt;br&gt;RoleRoutingViewModel&lt;br&gt;ProfileViewModel (Profile tab)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=4;" vertex="1" parent="vmL"><mxGeometry x="443" y="32" width="220" height="118" as="geometry"/></mxCell>
<mxCell id="venVM" value="&lt;b&gt;Venue ViewModels&lt;/b&gt;&lt;br&gt;VenueEntryViewModel, VenueInitializationViewModel,&lt;br&gt;VenueAreaViewModel, CreateQuestViewModel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="vmL"><mxGeometry x="683" y="32" width="407" height="118" as="geometry"/></mxCell>
<mxCell id="venVMP" value="&lt;i&gt;Planned:&lt;/i&gt; DashboardVM, InboxVM, ReviewVM, StatsVM, BusinessProfileVM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="venVM"><mxGeometry x="12" y="60" width="383" height="48" as="geometry"/></mxCell>
<mxCell id="modelL" value="Model: repositories" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="523" width="1105" height="204" as="geometry"/></mxCell>
<mxCell id="expR" value="&lt;b&gt;Explorer only&lt;/b&gt; (planned)&lt;br&gt;RouteRepo, PartyRepo, ChatRepo, RatingRepo, PostRepo (posts, reports), RankRepo" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=13;spacing=4;" vertex="1" parent="modelL"><mxGeometry x="15" y="32" width="210" height="160" as="geometry"/></mxCell>
<mxCell id="worker" value="&lt;b&gt;Offline worker&lt;/b&gt; (planned)&lt;br&gt;WorkManager, local file queue: proof and post photo uploads" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="modelL"><mxGeometry x="240" y="32" width="130" height="160" as="geometry"/></mxCell>
<mxCell id="shR" value="&lt;b&gt;Shared by both roles&lt;/b&gt;&lt;br&gt;AuthRepository (email, Google), UserRepository&lt;br&gt;ProfileSetup and PendingRoleStore (chosen role)&lt;br&gt;QuestRepository and VenueRepository&lt;br&gt;(venues write, explorers read)&lt;br&gt;LocationRepository (device location, GPS)&lt;br&gt;ReservationRepository (no screen uses it yet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="modelL"><mxGeometry x="385" y="32" width="470" height="160" as="geometry"/></mxCell>
<mxCell id="shRP" value="&lt;i&gt;Planned:&lt;/i&gt; CompletionRepo (attempts, proofs, reviews)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="shR"><mxGeometry x="12" y="128" width="446" height="26" as="geometry"/></mxCell>
<mxCell id="venR" value="&lt;b&gt;Venue only&lt;/b&gt;&lt;br&gt;AddressSearchRepository&lt;br&gt;(venue setup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="modelL"><mxGeometry x="870" y="32" width="220" height="160" as="geometry"/></mxCell>
<mxCell id="venRP" value="&lt;i&gt;Planned:&lt;/i&gt; StatsRepo" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="venR"><mxGeometry x="12" y="128" width="196" height="26" as="geometry"/></mxCell>
<mxCell id="dataL" value="Services: Firebase, Google and Android" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="865" width="1280" height="205" as="geometry"/></mxCell>
<mxCell id="maps" value="&lt;b&gt;Google Maps&lt;/b&gt;&lt;br&gt;Maps SDK (Compose); walking routes: planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=4;fontSize=12;" vertex="1" parent="dataL"><mxGeometry x="15" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="storage" value="&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;(planned)&lt;br&gt;photos, proof images, role-based rules" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="141" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="fn" value="&lt;b&gt;Cloud Functions&lt;/b&gt;&lt;br&gt;(planned)&lt;br&gt;points, GPS check, image moderation, post reports, queue matching, ranked results, expiry, rating stats" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=11;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="267" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="fs" value="&lt;b&gt;Firestore&lt;/b&gt;&lt;br&gt;users, venues, quests, reservations; offline cache; rules v2 check roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=4;fontSize=12;" vertex="1" parent="dataL"><mxGeometry x="393" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="auth" value="&lt;b&gt;Firebase Auth&lt;/b&gt;&lt;br&gt;email, Google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=4;fontSize=12;" vertex="1" parent="dataL"><mxGeometry x="519" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="loc" value="&lt;b&gt;Fused location&lt;/b&gt;&lt;br&gt;(Play services)&lt;br&gt;GPS: the app's sensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=4;fontSize=12;" vertex="1" parent="dataL"><mxGeometry x="645" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="prefs" value="&lt;b&gt;Shared Preferences&lt;/b&gt;&lt;br&gt;on device: pending role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=4;fontSize=12;" vertex="1" parent="dataL"><mxGeometry x="771" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="geo" value="&lt;b&gt;Android Geocoder&lt;/b&gt;&lt;br&gt;address search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=4;fontSize=12;" vertex="1" parent="dataL"><mxGeometry x="897" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="fcm" value="&lt;b&gt;FCM&lt;/b&gt;&lt;br&gt;(planned)&lt;br&gt;push notifications" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="1023" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="cm" value="&lt;b&gt;Credential Manager&lt;/b&gt;&lt;br&gt;Google account chooser, Google ID token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;spacing=4;fontSize=12;" vertex="1" parent="dataL"><mxGeometry x="1149" y="32" width="116" height="125" as="geometry"/></mxCell>
<mxCell id="legend" value="Solid boxes and arrows: built on main (Sprint 2). Grey dashed boxes and arrows: planned, not built yet. Solid arrows: calls (the View calls ViewModel methods, ViewModels call repositories, repositories call services). Dashed black arrows: the View observes a ViewModel StateFlow. Two-headed arrows: reads and writes, with realtime listeners and the Firestore offline cache. Map screens (explorer map, venue area, quest radius) use the Maps SDK directly; their state lives in their ViewModels. The login screen gets the Google ID token from Credential Manager and passes it to AuthViewModel. The role is a write-once field of the user document: ProfileSetup keeps the role chosen at registration in PendingRoleStore until the profile is saved, and Firestore rules v2 check it on venue, quest and reservation writes. Last updated: Sprint 2." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1083" width="1280" height="60" as="geometry"/></mxCell>
