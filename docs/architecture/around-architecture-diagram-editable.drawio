<mxfile host="app.diagrams.net"><diagram id="arch" name="System architecture"><mxGraphModel dx="1200" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1568" pageHeight="1178" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;System architecture: Android app with Explorer and Venue roles (MVVM + Firebase/Google)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="180" y="5" width="1228" height="30" as="geometry"/></mxCell>
<mxCell id="viewL" value="View: Jetpack Compose screens" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="55" width="1468" height="224" as="geometry"/></mxCell>
<mxCell id="exp" value="&lt;b&gt;Explorer app&lt;/b&gt; (bottom nav: Quests, Map, Profile)&lt;br&gt;Quests tab: accepted quests (pending or approved) with their venue; cancel one&lt;br&gt;Map: quest and venue pins, nearby quest pager, filters, location banner&lt;br&gt;Venue page: its quests and quest sheet; accept a quest (reservation)&lt;br&gt;Profile with sign-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="viewL"><mxGeometry x="15" y="32" width="505" height="180" as="geometry"/></mxCell>
<mxCell id="expP" value="&lt;i&gt;Later:&lt;/i&gt; companion queue, party chat, ranked matches, result, offline queue, leaderboard, friends, posts, rank rewards" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="exp"><mxGeometry x="12" y="104" width="235" height="66" as="geometry"/></mxCell>
<mxCell id="expS4" value="&lt;b&gt;Sprint 4:&lt;/b&gt; quest completion screen: take a photo or write the answer, then submit it for the venue&#x27;s review" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#333333;fontSize=12;spacing=4;" vertex="1" parent="exp"><mxGeometry x="258" y="104" width="235" height="66" as="geometry"/></mxCell>
<mxCell id="gate" value="&lt;b&gt;Login and role gate&lt;/b&gt;&lt;br&gt;Sign-in (email, Google), registration with role choice; opens the Explorer or Venue app for the saved role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;" vertex="1" parent="viewL"><mxGeometry x="540" y="32" width="220" height="110" as="geometry"/></mxCell>
<mxCell id="ven" value="&lt;b&gt;Venue app&lt;/b&gt; (bottom nav: Dashboard, Quests, Profile)&lt;br&gt;Venue entry: loads the owner&#x27;s venue, or runs setup (name, then area on a map with address search)&lt;br&gt;Dashboard: reservations to approve or decline, approved ones, active quest count&lt;br&gt;Quests tab: the venue&#x27;s quests; opens the create-quest form (rewards, radius map)&lt;br&gt;Profile with sign-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="viewL"><mxGeometry x="780" y="32" width="673" height="180" as="geometry"/></mxCell>
<mxCell id="venP" value="&lt;i&gt;Later:&lt;/i&gt; quest editing, slot settings, past reviews, completion stats, ratings, business profile" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="ven"><mxGeometry x="12" y="104" width="319" height="66" as="geometry"/></mxCell>
<mxCell id="venS4" value="&lt;b&gt;Sprint 4:&lt;/b&gt; the dashboard also lists submitted completions; the venue approves or rejects each proof" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;fontColor=#333333;fontSize=12;spacing=4;" vertex="1" parent="ven"><mxGeometry x="342" y="104" width="319" height="66" as="geometry"/></mxCell>
<mxCell id="vmL" value="ViewModel (StateFlow)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="1468" height="210" as="geometry"/></mxCell>
<mxCell id="expVM" value="&lt;b style=&quot;font-size:13px&quot;&gt;Explorer ViewModels&lt;/b&gt; (repositories each one calls)&lt;br&gt;MapViewModel: quests, venues, location&lt;br&gt;VenuePageViewModel (accept a quest): venues, quests, reservations, users&lt;br&gt;OverviewViewModel (Quests tab, cancel): reservations, quests, venues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="vmL"><mxGeometry x="15" y="32" width="505" height="166" as="geometry"/></mxCell>
<mxCell id="expVMP" value="&lt;i&gt;Later:&lt;/i&gt; QueueVM, ChatVM, RatingVM, RankVM, FriendsVM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="expVM"><mxGeometry x="12" y="116" width="235" height="40" as="geometry"/></mxCell>
<mxCell id="expVMS4" value="&lt;b&gt;Sprint 4:&lt;/b&gt; QuestCompletionViewModel: completions, proof photos" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#82b366;fontColor=#333333;fontSize=12;spacing=4;" vertex="1" parent="expVM"><mxGeometry x="258" y="116" width="235" height="40" as="geometry"/></mxCell>
<mxCell id="authVM" value="&lt;b style=&quot;font-size:13px&quot;&gt;Shared by both apps&lt;/b&gt;&lt;br&gt;AuthViewModel: auth, ProfileSetup&lt;br&gt;SessionViewModel: auth&lt;br&gt;RoleRoutingViewModel: auth, users, ProfileSetup&lt;br&gt;ProfileViewModel (Profile tab): auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="vmL"><mxGeometry x="540" y="32" width="220" height="166" as="geometry"/></mxCell>
<mxCell id="venVM" value="&lt;b style=&quot;font-size:13px&quot;&gt;Venue ViewModels&lt;/b&gt; (repositories each one calls)&lt;br&gt;VenueEntryViewModel: venues&lt;br&gt;VenueInitializationViewModel: auth, venues&lt;br&gt;VenueAreaViewModel: venues, location, address search&lt;br&gt;CreateQuestViewModel: auth, venues, quests&lt;br&gt;VenueQuestsViewModel (Quests tab): auth, quests&lt;br&gt;VenueDashboardViewModel (approve, decline): auth, reservations, quests, venues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="vmL"><mxGeometry x="780" y="32" width="673" height="166" as="geometry"/></mxCell>
<mxCell id="venVMP" value="&lt;i&gt;Later:&lt;/i&gt; ReviewVM (past reviews), StatsVM, BusinessProfileVM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=12;spacing=4;" vertex="1" parent="venVM"><mxGeometry x="12" y="116" width="319" height="40" as="geometry"/></mxCell>
<mxCell id="venVMS4" value="&lt;b&gt;Sprint 4:&lt;/b&gt; VenueDashboardViewModel reviews completions: completions, proof photos" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#82b366;fontColor=#333333;fontSize=12;spacing=4;" vertex="1" parent="venVM"><mxGeometry x="342" y="116" width="319" height="40" as="geometry"/></mxCell>
<mxCell id="modelL" value="Model: repositories" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="622" width="1468" height="204" as="geometry"/></mxCell>
<mxCell id="laterR" value="&lt;b&gt;Later&lt;/b&gt;&lt;br&gt;RouteRepo, ChatRepo, RatingRepo, PostRepo (posts, reports), RankRepo, StatsRepo on Firestore; offline worker (WorkManager) queuing photo uploads to Cloud Storage" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=11;spacing=4;" vertex="1" parent="modelL"><mxGeometry x="15" y="32" width="194" height="160" as="geometry"/></mxCell>
<mxCell id="devR" value="&lt;b&gt;Device&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="modelL"><mxGeometry x="219" y="32" width="194" height="160" as="geometry"/></mxCell>
<mxCell id="locRepo" value="&lt;b&gt;LocationRepository&lt;/b&gt;&lt;br&gt;current location (GPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="devR"><mxGeometry x="8" y="28" width="178" height="40" as="geometry"/></mxCell>
<mxCell id="addrRepo" value="&lt;b&gt;AddressSearchRepository&lt;/b&gt;&lt;br&gt;address search in venue setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="devR"><mxGeometry x="8" y="74" width="178" height="40" as="geometry"/></mxCell>
<mxCell id="accR" value="&lt;b&gt;Account&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="modelL"><mxGeometry x="423" y="32" width="300" height="160" as="geometry"/></mxCell>
<mxCell id="authRepo" value="&lt;b&gt;AuthRepository&lt;/b&gt;: email and Google sign-in, current session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="accR"><mxGeometry x="8" y="28" width="284" height="32" as="geometry"/></mxCell>
<mxCell id="userRepo" value="&lt;b&gt;UserRepository&lt;/b&gt;: profiles (display name, write-once role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="accR"><mxGeometry x="8" y="66" width="284" height="32" as="geometry"/></mxCell>
<mxCell id="setupRepo" value="&lt;b&gt;ProfileSetup&lt;/b&gt; with &lt;b&gt;PendingRoleStore&lt;/b&gt;: keeps the role chosen at registration until the profile is saved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="accR"><mxGeometry x="8" y="104" width="284" height="46" as="geometry"/></mxCell>
<mxCell id="vqR" value="&lt;b&gt;Venues and quests&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="modelL"><mxGeometry x="733" y="32" width="186" height="160" as="geometry"/></mxCell>
<mxCell id="venueRepo" value="&lt;b&gt;VenueRepository&lt;/b&gt;&lt;br&gt;a venue writes its own; everyone signed in reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="vqR"><mxGeometry x="8" y="28" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="questRepo" value="&lt;b&gt;QuestRepository&lt;/b&gt;&lt;br&gt;stores the venueId only: the venue&#x27;s name and location are read from the venue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="vqR"><mxGeometry x="8" y="84" width="170" height="64" as="geometry"/></mxCell>
<mxCell id="resR" value="&lt;b&gt;Reservations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="modelL"><mxGeometry x="929" y="32" width="186" height="160" as="geometry"/></mxCell>
<mxCell id="resRepo" value="&lt;b&gt;ReservationRepository&lt;/b&gt;&lt;br&gt;create; observe per explorer or venue; update status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="resR"><mxGeometry x="8" y="28" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="partyRepo" value="&lt;b&gt;PartyRepository&lt;/b&gt; (in review)&lt;br&gt;party_user memberships" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#d6b656;fontColor=#333333;fontSize=11;spacing=4;" vertex="1" parent="resR"><mxGeometry x="8" y="90" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="compR" value="&lt;b&gt;Completions&lt;/b&gt; (Sprint 4)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#d6b656;fontColor=#333333;fontSize=13;spacing=4;verticalAlign=top;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="modelL"><mxGeometry x="1125" y="32" width="328" height="160" as="geometry"/></mxCell>
<mxCell id="compModel" value="&lt;b&gt;Completion&lt;/b&gt; and &lt;b&gt;Proof&lt;/b&gt; models: built in Sprint 3, no repository yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=3;" vertex="1" parent="compR"><mxGeometry x="8" y="28" width="312" height="34" as="geometry"/></mxCell>
<mxCell id="compRepo" value="&lt;b&gt;CompletionRepository&lt;/b&gt; and its Firestore implementation; security rules for completions" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#d6b656;fontColor=#333333;fontSize=11;spacing=4;" vertex="1" parent="compR"><mxGeometry x="8" y="68" width="312" height="40" as="geometry"/></mxCell>
<mxCell id="photoRepo" value="&lt;b&gt;ProofPhotoRepository&lt;/b&gt;: uploads proof photos to Cloud Storage" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#d6b656;fontColor=#333333;fontSize=11;spacing=4;" vertex="1" parent="compR"><mxGeometry x="8" y="114" width="312" height="36" as="geometry"/></mxCell>
<mxCell id="dataL" value="Services: Firebase, Google and Android" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=bottom;spacingBottom=4;align=left;spacingLeft=10;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="936" width="1468" height="138" as="geometry"/></mxCell>
<mxCell id="cm" value="&lt;b&gt;Credential Manager&lt;/b&gt;&lt;br&gt;Google account chooser, Google ID token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="15" y="10" width="92" height="100" as="geometry"/></mxCell>
<mxCell id="maps" value="&lt;b&gt;Google Maps&lt;/b&gt;&lt;br&gt;Maps SDK (Compose)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="117" y="10" width="92" height="100" as="geometry"/></mxCell>
<mxCell id="loc" value="&lt;b&gt;Fused location&lt;/b&gt;&lt;br&gt;(Play services)&lt;br&gt;GPS: the app&#x27;s sensor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="219" y="10" width="92" height="100" as="geometry"/></mxCell>
<mxCell id="geo" value="&lt;b&gt;Android Geocoder&lt;/b&gt;&lt;br&gt;address search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="321" y="10" width="92" height="100" as="geometry"/></mxCell>
<mxCell id="prefs" value="&lt;b&gt;Shared Preferences&lt;/b&gt;&lt;br&gt;on device: pending role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="423" y="10" width="92" height="100" as="geometry"/></mxCell>
<mxCell id="auth" value="&lt;b&gt;Firebase Auth&lt;/b&gt;&lt;br&gt;email, Google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="525" y="10" width="92" height="100" as="geometry"/></mxCell>
<mxCell id="fs" value="&lt;b&gt;Firestore&lt;/b&gt;: offline cache; security rules v2 check roles, fields and status changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=4;verticalAlign=bottom;spacingBottom=4;container=1;collapsible=0;" vertex="1" parent="dataL"><mxGeometry x="627" y="10" width="594" height="100" as="geometry"/></mxCell>
<mxCell id="c_users" value="users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=3;" vertex="1" parent="fs"><mxGeometry x="8" y="10" width="88" height="48" as="geometry"/></mxCell>
<mxCell id="c_venues" value="venues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=3;" vertex="1" parent="fs"><mxGeometry x="106" y="10" width="88" height="48" as="geometry"/></mxCell>
<mxCell id="c_quests" value="quests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=3;" vertex="1" parent="fs"><mxGeometry x="204" y="10" width="88" height="48" as="geometry"/></mxCell>
<mxCell id="c_res" value="reservations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=3;" vertex="1" parent="fs"><mxGeometry x="302" y="10" width="88" height="48" as="geometry"/></mxCell>
<mxCell id="c_party" value="party_user&lt;br&gt;(in review)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#333333;fontSize=12;spacing=4;" vertex="1" parent="fs"><mxGeometry x="400" y="10" width="88" height="48" as="geometry"/></mxCell>
<mxCell id="c_comp" value="completions&lt;br&gt;(and rules)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#333333;fontSize=12;spacing=4;" vertex="1" parent="fs"><mxGeometry x="498" y="10" width="88" height="48" as="geometry"/></mxCell>
<mxCell id="storage" value="&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;(Sprint 4)&lt;br&gt;proof photos; no bucket yet" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#333333;fontSize=12;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="1231" y="10" width="92" height="100" as="geometry"/></mxCell>
<mxCell id="later_s" value="&lt;b&gt;Later&lt;/b&gt;&lt;br&gt;Cloud Functions (points, GPS check, moderation, matching, expiry); FCM push to an in-app receiver" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=11;spacing=4;" vertex="1" parent="dataL"><mxGeometry x="1333" y="10" width="120" height="100" as="geometry"/></mxCell>
<mxCell id="lg1" value="Built on main (end of Sprint 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1088" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="lg2" value="Sprint 4: planned, or in review" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="270" y="1088" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="lg3" value="Later: backlog, not scheduled" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#ffffff;strokeColor=#9e9e9e;fontColor=#666666;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="490" y="1088" width="200" height="26" as="geometry"/></mxCell>
<mxCell id="lg4" value="Arrows from ViewModels to repositories: &lt;font color=&quot;#2f6db5&quot;&gt;&lt;b&gt;blue&lt;/b&gt;&lt;/font&gt; from the Explorer ViewModels, &lt;font color=&quot;#c25e00&quot;&gt;&lt;b&gt;orange&lt;/b&gt;&lt;/font&gt; from the Venue ViewModels, &lt;b&gt;black&lt;/b&gt; from the shared ones; dashed: Sprint 4." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="705" y="1088" width="823" height="26" as="geometry"/></mxCell>
<mxCell id="legend" value="Solid arrows: calls (the View calls ViewModel methods, ViewModels call repositories, repositories call services). Dashed black arrows: the View observes a ViewModel StateFlow. Each ViewModel line names the repositories it calls, and one arrow per repository block shows the dependency. Arrows to services are labelled with the repository that calls them; two-headed arrows read and write, with realtime listeners and the Firestore offline cache. Each repository is an interface with one implementation (Firestore, Firebase Auth or Android) built by a Provider; Auth, User, Venue, Quest and Reservation also have a fake for tests. Map screens (explorer map, venue area, quest radius) use the Maps SDK directly. The login screen gets the Google ID token from Credential Manager and passes it to AuthViewModel. The role is a write-once field of the user document; Firestore rules v2 check it on venue, quest and reservation writes. Last updated: Sprint 3." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="1468" height="48" as="geometry"/></mxCell>
