<mxCell id="exp" value="&lt;b&gt;Explorer shell&lt;/b&gt; (bottom nav, 4 tabs)&lt;br&gt;Map, quest list and detail, companion queue,&lt;br&gt;party chat, ranked matches, reservation, proof, result,&lt;br&gt;my quests, offline queue, leaderboard, friends,&lt;br&gt;profile, posts, rank rewards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;" vertex="1" parent="viewL"><mxGeometry x="15" y="32" width="450" height="95" as="geometry"/></mxCell>
<mxCell id="ven" value="&lt;b&gt;Venue shell&lt;/b&gt; (dashboard, no map)&lt;br&gt;Quest list and editor, slot settings,&lt;br&gt;reservation inbox, upcoming visits, review queue,&lt;br&gt;past reviews, completion stats, ratings,&lt;br&gt;business profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;spacing=4;" vertex="1" parent="viewL"><mxGeometry x="495" y="32" width="450" height="95" as="geometry"/></mxCell>
