rules_version = '2';

// Co-authored-by: OpenAI Codex <noreply@openai.com>
// Co-authored-by: Claude Sonnet 5.5 <noreply@anthropic.com>
// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
// Firestore security rules v2, following docs/firestore-schema.md (schema v1).
// Anything not allowed below is denied. Every write is checked against the schema: only its fields,
// the required ones present, with their types, values and limits.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The signed-in user's profile has [role]. Costs one document read.
    function hasRole(role) {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.get('role', null) == role;
    }

    function isText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Optional fields are omitted when null, so an absent field is valid.
    function isOptionalText(data, field, maxLength) {
      return !(field in data) || isText(data[field], maxLength);
    }

    function isFilledText(value, maxLength) {
      return isText(value, maxLength) && value.trim().size() > 0;
    }

    function isRadius(value) {
      return value is int && value >= 20 && value <= 200;
    }

    function isValidUser(data, uid) {
      return data.keys().hasAll(['displayName', 'createdAt'])
          && data.keys().hasOnly(['displayName', 'pictureUrl', 'role', 'createdAt'])
          && isText(data.displayName, 100)
          && (!('pictureUrl' in data)
              || (isText(data.pictureUrl, 2000)
                  && data.pictureUrl.matches(
                      'gs://[^/]+/user-pictures/' + uid + '/[^/]+')))
          && data.get('role', null) in [null, 'EXPLORER', 'VENUE']
          && data.createdAt is timestamp;
    }

    function isValidVenue(data) {
      return data.keys().hasAll(['name', 'radiusMeters', 'createdAt'])
          && data.keys().hasOnly(
              ['name', 'location', 'radiusMeters', 'address', 'createdAt', 'featuredQuestId'])
          && isText(data.name, 100)
          && (!('location' in data) || data.location is latlng)
          && isRadius(data.radiusMeters)
          && (!('address' in data) || data.address is string)
          && data.createdAt is timestamp
          && (!('featuredQuestId' in data) || data.featuredQuestId is string);
    }

    // A quest without a location takes place at its venue's location.
    function isValidQuest(data) {
      return data.keys().hasAll(['venueId', 'radiusMeters', 'title', 'description',
              'requirements', 'proofType', 'minPartySize', 'status', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['venueId', 'location', 'radiusMeters', 'title', 'description',
              'requirements', 'proofType', 'minPartySize', 'exactPartySize', 'reward', 'status',
              'createdAt', 'updatedAt'])
          && (!('location' in data) || data.location is latlng)
          && isRadius(data.radiusMeters)
          && isText(data.title, 60)
          && isText(data.description, 500)
          && isText(data.requirements, 300)
          && data.proofType in ['PHOTO', 'TEXT']
          && data.minPartySize is int
          && data.minPartySize >= 1
          && (!('exactPartySize' in data) || data.exactPartySize is bool)
          && (!('reward' in data) || isValidReward(data.reward))
          && data.status in ['DRAFT', 'ACTIVE', 'ARCHIVED']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    // A reward holds its type, that type's fields and an optional expiry.
    function isValidReward(reward) {
      return reward is map
          && (!('expiresAt' in reward) || reward.expiresAt is timestamp)
          && (isDiscount(reward) || isFreeItem(reward) || isOtherReward(reward));
    }

    function isDiscount(reward) {
      return reward.get('type', null) == 'DISCOUNT'
          && reward.keys().hasAll(['type', 'amount', 'unit'])
          && reward.keys().hasOnly(['type', 'amount', 'unit', 'specifics', 'expiresAt'])
          && reward.amount is number
          && reward.amount >= 0.01
          && ((reward.unit == 'CHF' && reward.amount <= 1000)
              || (reward.unit == 'PERCENT' && reward.amount <= 100))
          && isOptionalText(reward, 'specifics', 200);
    }

    function isFreeItem(reward) {
      return reward.get('type', null) == 'FREE_ITEM'
          && reward.keys().hasAll(['type', 'name'])
          && reward.keys().hasOnly(['type', 'name', 'specifics', 'expiresAt'])
          && isText(reward.name, 60)
          && isOptionalText(reward, 'specifics', 200);
    }

    function isOtherReward(reward) {
      return reward.get('type', null) == 'OTHER'
          && reward.keys().hasAll(['type', 'description'])
          && reward.keys().hasOnly(['type', 'description', 'expiresAt'])
          && isText(reward.description, 200);
    }

    // The party isn't stored on the reservation: it is the reservation's memberships in party_user.
    // joinedCount counts its JOINED ones, since rules can't count documents, to cap the party.
    function isValidReservation(data) {
      return data.keys().hasAll(['questId', 'venueId', 'slotStart', 'status', 'createdAt',
              'explorerName', 'joinedCount'])
          && data.keys().hasOnly(['questId', 'venueId', 'slotStart', 'status', 'createdAt',
              'explorerName', 'joinedCount', 'partyCode'])
          && data.questId is string
          && data.venueId is string
          && data.slotStart is timestamp
          && data.createdAt is timestamp
          && data.explorerName is string
          && data.joinedCount is int;
    }

    // The most explorers a party holds at once.
    function maxPartySize() {
      return 10;
    }

    // The quest of the reservation [data]. Costs one document read.
    function questOf(data) {
      return get(/databases/$(database)/documents/quests/$(data.questId)).data;
    }

    // The most joined members a party for [quest] holds: its size if exact, else maxPartySize(),
    // and never more than maxPartySize(). Quests written before exactPartySize are read as at
    // least.
    function partyCapacity(quest) {
      return quest.get('exactPartySize', false) && quest.minPartySize < maxPartySize()
          ? quest.minPartySize
          : maxPartySize();
    }

    // A party of [joined] members has the size [quest] asks for: exactly or at least minPartySize.
    function meetsPartySize(quest, joined) {
      return quest.get('exactPartySize', false)
          ? joined == quest.minPartySize
          : joined >= quest.minPartySize;
    }

    // [name] is the display name in the signed-in user's profile, so nobody reserves under another
    // name. Reads the same profile as hasRole, which rules count as one document read.
    function isOwnDisplayName(name) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          == name;
    }

    // [time] is now or later. The app sets a new reservation's slotStart from the phone's clock,
    // which can be a little behind the server's, so it may be up to 5 minutes earlier.
    function isNotInThePast(time) {
      return time >= request.time - duration.value(5, 'm');
    }

    // The reservation's quest exists, is active and belongs to the venue the reservation names.
    // Costs one document read.
    function isForActiveQuestOfItsVenue(data) {
      let quest = /databases/$(database)/documents/quests/$(data.questId);
      return exists(quest)
          && get(quest).data.status == 'ACTIVE'
          && get(quest).data.venueId == data.venueId;
    }

    // The schema's allowed status transitions for reservations.
    function isReservationTransition(from, to) {
      return (from == 'PENDING' && to in ['APPROVED', 'REJECTED', 'CANCELLED'])
          || (from == 'APPROVED' && to == 'CANCELLED');
    }

    function isValidPartyMember(data) {
      return data.keys().hasAll(['reservationId', 'uid', 'status', 'joinedAt', 'updatedAt'])
          && data.keys().hasOnly(['reservationId', 'uid', 'status', 'joinedAt', 'updatedAt'])
          && data.reservationId is string
          && data.uid is string
          && data.status in ['JOINED', 'WITHDRAWN']
          && data.joinedAt is timestamp
          && data.updatedAt is timestamp;
    }

    function reservation(reservationId) {
      return /databases/$(database)/documents/reservations/$(reservationId);
    }

    // The signed-in user's membership in the party of [reservationId]. Its id is built from the
    // reservation and the user, so checking it costs one document read.
    function ownMembership(reservationId) {
      return /databases/$(database)/documents/party_user/$(reservationId + '_' + request.auth.uid);
    }

    // The signed-in user has a membership in the party of [reservationId], joined or withdrawn.
    function isMember(reservationId) {
      return exists(ownMembership(reservationId));
    }

    // The party's completion of [reservationId]. Its id is the reservation's, so checking it costs
    // one document read.
    function partyCompletion(reservationId) {
      return /databases/$(database)/documents/completions/$(reservationId);
    }

    // The membership [data] is the creator's: the creator's membership is written in one batch with
    // the reservation and joined at its creation time, which no later join may have.
    function isCreatorMembership(data) {
      return data.joinedAt == get(reservation(data.reservationId)).data.createdAt;
    }

    // [code] is a party code: 6 characters out of the digits 2 to 9 and the capital letters but I,
    // L and O, which are easy to mistake for one another.
    function isPartyCode(code) {
      return code is string && code.matches('[2-9A-HJKMNP-Z]{6}');
    }

    function partyCode(code) {
      return /databases/$(database)/documents/party_codes/$(code);
    }

    // The reservation [data], created as [reservationId], has a party code written in the same
    // batch that leads back to it. Reservations created before party codes have none.
    function hasOwnPartyCode(data, reservationId) {
      return 'partyCode' in data
          && isPartyCode(data.partyCode)
          && getAfter(partyCode(data.partyCode)).data.reservationId == reservationId;
    }

    // The signed-in user is a joined member of the party of [reservationId].
    function isJoinedMember(reservationId) {
      return isMember(reservationId)
          && get(ownMembership(reservationId)).data.status == 'JOINED';
    }

    // The signed-in user is a joined member of the party of [reservationId] once this write is
    // applied, e.g. through a membership created in the same batch.
    function willBeJoinedMember(reservationId) {
      return existsAfter(ownMembership(reservationId))
          && getAfter(ownMembership(reservationId)).data.status == 'JOINED';
    }

    // This write moves the reservation's joinedCount by [delta] only, in one batch with the
    // signed-in user's own membership joining (+1, while pending and not full) or withdrawing (-1).
    // A join costs one more read, for the quest's party capacity.
    function isJoinedCountChange(reservationId, delta) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedCount'])
          && request.resource.data.joinedCount == resource.data.joinedCount + delta
          && ((delta == 1
                  && resource.data.status == 'PENDING'
                  && request.resource.data.joinedCount <= partyCapacity(questOf(resource.data))
                  && !exists(ownMembership(reservationId))
                  && willBeJoinedMember(reservationId))
              || (delta == -1
                  && isJoinedMember(reservationId)
                  && getAfter(ownMembership(reservationId)).data.status == 'WITHDRAWN'));
    }

    // The joinedCount of [reservationId] moves by [delta] in this write. A reservation created in
    // the same batch starts at 1, for its creator.
    function movesJoinedCount(reservationId, delta) {
      return exists(reservation(reservationId))
          ? getAfter(reservation(reservationId)).data.joinedCount
              == get(reservation(reservationId)).data.joinedCount + delta
          : getAfter(reservation(reservationId)).data.joinedCount == 1;
    }

    // A completion as the explorer submits it: pending and without a reject reason. Its proof is
    // checked by isProofOfType.
    function isValidCompletion(data) {
      return data.keys().hasAll(['reservationId', 'venueId', 'explorerUid', 'status',
              'submittedAt'])
          && data.keys().hasOnly(['reservationId', 'venueId', 'explorerUid', 'photoUrl',
              'textAnswer', 'status', 'submittedAt'])
          && data.reservationId is string
          && data.venueId is string
          && data.explorerUid is string
          && data.status == 'PENDING'
          && data.submittedAt is timestamp;
    }

    // [data] holds one proof, not blank, of the proof type [type].
    function isProofOfType(data, type) {
      return (type == 'PHOTO'
              && !('textAnswer' in data)
              && isFilledText(data.get('photoUrl', ''), 2000))
          || (type == 'TEXT'
              && !('photoUrl' in data)
              && isFilledText(data.get('textAnswer', ''), 1000));
    }

    // The completion [data] is for an approved reservation of the venue it names, with the proof
    // its quest asks for. Costs two document reads.
    function isProofOfApprovedReservation(data) {
      let booked = get(reservation(data.reservationId)).data;
      let quest = /databases/$(database)/documents/quests/$(booked.questId);
      return booked.status == 'APPROVED'
          && booked.venueId == data.venueId
          && isProofOfType(data, get(quest).data.proofType);
    }

    // The venue's answer, changing nothing else: a pending completion becomes rejected with a
    // reason, and a pending or rejected one becomes approved, without a reason.
    function isCompletionAnswer(before, after) {
      return after.diff(before).affectedKeys().hasOnly(['status', 'rejectReason'])
          && ((before.status in ['PENDING', 'REJECTED']
                  && after.status == 'APPROVED'
                  && !('rejectReason' in after))
              || (before.status == 'PENDING'
                  && after.status == 'REJECTED'
                  && isFilledText(after.rejectReason, 300)));
    }

    // Signed-in users get profiles by uid for names and pictures, but cannot list all users.
    // The role is write-once: it can be chosen while null, then never changed.
    match /users/{uid} {
      allow get: if signedIn();
      allow create: if isUser(uid) && isValidUser(request.resource.data, uid);
      allow update: if isUser(uid)
          && isValidUser(request.resource.data, uid)
          && request.resource.data.createdAt == resource.data.createdAt
          && (resource.data.get('role', null) == null
              || request.resource.data.get('role', null) == resource.data.role);
    }

    // One venue per account: the document id is the owner's uid, and the owner is a venue account.
    match /venues/{ownerUid} {
      allow read: if signedIn();
      allow create, update: if isUser(ownerUid)
          && hasRole('VENUE')
          && isValidVenue(request.resource.data);
      allow delete: if isUser(ownerUid) && hasRole('VENUE');
    }

    // venueId is the owning venue's uid and can't be reassigned; createdAt can't change either.
    match /quests/{questId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.venueId)
          && hasRole('VENUE')
          && isValidQuest(request.resource.data);
      allow update: if isUser(resource.data.venueId)
          && request.resource.data.venueId == resource.data.venueId
          && request.resource.data.createdAt == resource.data.createdAt
          && hasRole('VENUE')
          && isValidQuest(request.resource.data);
      allow delete: if isUser(resource.data.venueId) && hasRole('VENUE');
    }

    // An explorer account creates a pending reservation, in one batch with their own joined
    // membership, joined at the reservation's createdAt, which marks them as its creator, and
    // optionally with its party code. It carries their profile's display name and doesn't start in
    // the past, for an active quest of the venue it names, with a joinedCount of 1. Afterwards the
    // status changes along an allowed transition: the venue answers a pending one, approving only a
    // party of the size its quest asks for, and never cancels an approved one (#475), and a joined
    // member of the party can cancel it until the party sends its proof, whatever its status.
    // joinedCount only moves with a membership joining or withdrawing in the same batch, and never
    // above the quest's party capacity. An explorer may get a reservation they know the id of, as
    // one given a party code does to see the quest, status and joinedCount of the party before
    // joining it. A venue gets its own reservations. Anyone signed in may find that an id has no
    // reservation: the app listens to a reservation it just created, offline maybe, before the
    // server has it, and a venue answering an unknown id gets "missing". Only the reservation's
    // venue lists them.
    match /reservations/{reservationId} {
      allow get: if signedIn()
          && (resource == null
              || request.auth.uid == resource.data.venueId
              || hasRole('EXPLORER'));
      allow list: if signedIn() && request.auth.uid == resource.data.venueId;
      allow create: if signedIn()
          && hasRole('EXPLORER')
          && isValidReservation(request.resource.data)
          && willBeJoinedMember(reservationId)
          && getAfter(ownMembership(reservationId)).data.joinedAt
              == request.resource.data.createdAt
          && hasOwnPartyCode(request.resource.data, reservationId)
          && isOwnDisplayName(request.resource.data.explorerName)
          && request.resource.data.status == 'PENDING'
          && request.resource.data.joinedCount == 1
          && isNotInThePast(request.resource.data.slotStart)
          && isForActiveQuestOfItsVenue(request.resource.data);
      allow update: if signedIn()
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                  && isReservationTransition(resource.data.status, request.resource.data.status)
                  && ((request.auth.uid == resource.data.venueId
                          && resource.data.status == 'PENDING'
                          && (request.resource.data.status != 'APPROVED'
                              || meetsPartySize(questOf(resource.data), resource.data.joinedCount)))
                      || (isJoinedMember(reservationId)
                          && request.resource.data.status == 'CANCELLED'
                          && !exists(partyCompletion(reservationId)))))
              || isJoinedCountChange(reservationId, 1)
              || isJoinedCountChange(reservationId, -1));
    }

    // One membership per explorer and reservation, under the id `{reservationId}_{uid}`. An
    // explorer account joins a pending reservation as themselves, in one batch that adds 1 to its
    // joinedCount, which caps the party; getAfter also sees a reservation created in the same
    // batch, where the membership is the creator's and the reservation's rule checks it is joined
    // at its createdAt; a later join can't be joined at that time. Afterwards the member can only
    // withdraw, while the reservation is pending or approved and before the party sends its proof,
    // which also moves updatedAt and takes 1 off joinedCount, and never join again. The creator
    // never withdraws: they cancel the reservation instead. The party's members, withdrawn ones
    // too, and the reservation's venue read it, so a member who withdrew still sees who else was in
    // the party.
    // Memberships are never deleted, so a withdrawal stays recorded.
    // A reservation that doesn't exist has no memberships, and anyone signed in may list them: the
    // app listens to the party of a reservation it just created before the server has it.
    match /party_user/{memberId} {
      allow read: if signedIn()
          && (request.auth.uid == resource.data.uid
              || isMember(resource.data.reservationId)
              || !exists(reservation(resource.data.reservationId))
              || request.auth.uid == get(reservation(resource.data.reservationId)).data.venueId);
      allow create: if signedIn()
          && hasRole('EXPLORER')
          && isValidPartyMember(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && memberId == request.resource.data.reservationId + '_' + request.auth.uid
          && request.resource.data.status == 'JOINED'
          && getAfter(reservation(request.resource.data.reservationId)).data.status == 'PENDING'
          && (!exists(reservation(request.resource.data.reservationId))
              || !isCreatorMembership(request.resource.data))
          && movesJoinedCount(request.resource.data.reservationId, 1);
      allow update: if isUser(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasAll(['status', 'updatedAt'])
          && resource.data.status == 'JOINED'
          && request.resource.data.status == 'WITHDRAWN'
          && request.resource.data.updatedAt is timestamp
          && get(reservation(resource.data.reservationId)).data.status in ['PENDING', 'APPROVED']
          && !isCreatorMembership(resource.data)
          && !exists(partyCompletion(resource.data.reservationId))
          && movesJoinedCount(resource.data.reservationId, -1);
    }

    // A party code, under its id, leads to its reservation, so an explorer who was given the code
    // can find the reservation to join. Anyone signed in may get a code they know, but nobody
    // lists them. It is created only in one batch with its reservation, by the reservation's
    // creator, and never changes: writing a code that is taken is an update, which is refused, so
    // codes stay unique.
    match /party_codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
          && isPartyCode(code)
          && request.resource.data.keys().hasOnly(['reservationId'])
          && request.resource.data.reservationId is string
          && !exists(reservation(request.resource.data.reservationId))
          && getAfter(reservation(request.resource.data.reservationId)).data.get('partyCode', null)
              == code;
    }

    // One completion per reservation, under the reservation's id: one proof for the whole party.
    // Any joined member of an approved reservation submits it, pending, as themselves, with the
    // proof its quest asks for; only explorer accounts join parties, so that needs no role check.
    // It can only be created, so a second submission, by the same member or another, is refused
    // whatever the first one's status. Only the venue answers it, and can still approve what it
    // rejected, but an approval is final. The member who sent it, the party's joined members and
    // the venue read it. Anyone signed in may find that an id has no completion, which is how an
    // answer to an unknown id reports it. Completions are never deleted.
    match /completions/{completionId} {
      allow get: if signedIn()
          && (resource == null
              || request.auth.uid == resource.data.explorerUid
              || request.auth.uid == resource.data.venueId
              || isJoinedMember(resource.data.reservationId));
      allow list: if signedIn()
          && (request.auth.uid == resource.data.explorerUid
              || request.auth.uid == resource.data.venueId
              || isJoinedMember(resource.data.reservationId));
      allow create: if signedIn()
          && isValidCompletion(request.resource.data)
          && request.resource.data.explorerUid == request.auth.uid
          && completionId == request.resource.data.reservationId
          && isJoinedMember(request.resource.data.reservationId)
          && isProofOfApprovedReservation(request.resource.data);
      allow update: if isUser(resource.data.venueId)
          && isCompletionAnswer(resource.data, request.resource.data);
    }
  }
}
