rules_version = '2';

// Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
// Firestore security rules v2, following docs/firestore-schema.md (schema v1).
// Anything not allowed below is denied. Every write is checked against the schema: only its fields,
// the required ones present, with their types, values and limits.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The signed-in user's profile has [role]. Costs one document read.
    function hasRole(role) {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.get('role', null) == role;
    }

    function isText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Optional fields are omitted when null, so an absent field is valid.
    function isOptionalText(data, field, maxLength) {
      return !(field in data) || isText(data[field], maxLength);
    }

    function isRadius(value) {
      return value is int && value >= 20 && value <= 200;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'createdAt'])
          && data.keys().hasOnly(['displayName', 'role', 'createdAt'])
          && data.displayName is string
          && data.get('role', null) in [null, 'EXPLORER', 'VENUE']
          && data.createdAt is timestamp;
    }

    function isValidVenue(data) {
      return data.keys().hasAll(['name', 'radiusMeters', 'createdAt'])
          && data.keys().hasOnly(
              ['name', 'location', 'radiusMeters', 'address', 'createdAt', 'featuredQuestId'])
          && isText(data.name, 100)
          && (!('location' in data) || data.location is latlng)
          && isRadius(data.radiusMeters)
          && (!('address' in data) || data.address is string)
          && data.createdAt is timestamp
          && (!('featuredQuestId' in data) || data.featuredQuestId is string);
    }

    function isValidQuest(data) {
      return data.keys().hasAll(['venueId', 'radiusMeters', 'title', 'description',
              'requirements', 'proofType', 'minPartySize', 'status', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['venueId', 'radiusMeters', 'title', 'description',
              'requirements', 'proofType', 'minPartySize', 'exactPartySize', 'reward', 'status',
              'createdAt', 'updatedAt'])
          && isRadius(data.radiusMeters)
          && isText(data.title, 60)
          && isText(data.description, 500)
          && isText(data.requirements, 300)
          && data.proofType in ['PHOTO', 'TEXT']
          && data.minPartySize is int
          && data.minPartySize >= 1
          && (!('exactPartySize' in data) || data.exactPartySize is bool)
          && (!('reward' in data) || isValidReward(data.reward))
          && data.status in ['DRAFT', 'ACTIVE', 'ARCHIVED']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    // A reward holds its type, that type's fields and an optional expiry.
    function isValidReward(reward) {
      return reward is map
          && (!('expiresAt' in reward) || reward.expiresAt is timestamp)
          && (isDiscount(reward) || isFreeItem(reward) || isOtherReward(reward));
    }

    function isDiscount(reward) {
      return reward.get('type', null) == 'DISCOUNT'
          && reward.keys().hasAll(['type', 'amount', 'unit'])
          && reward.keys().hasOnly(['type', 'amount', 'unit', 'specifics', 'expiresAt'])
          && reward.amount is number
          && reward.amount >= 0.01
          && ((reward.unit == 'CHF' && reward.amount <= 1000)
              || (reward.unit == 'PERCENT' && reward.amount <= 100))
          && isOptionalText(reward, 'specifics', 200);
    }

    function isFreeItem(reward) {
      return reward.get('type', null) == 'FREE_ITEM'
          && reward.keys().hasAll(['type', 'name'])
          && reward.keys().hasOnly(['type', 'name', 'specifics', 'expiresAt'])
          && isText(reward.name, 60)
          && isOptionalText(reward, 'specifics', 200);
    }

    function isOtherReward(reward) {
      return reward.get('type', null) == 'OTHER'
          && reward.keys().hasAll(['type', 'description'])
          && reward.keys().hasOnly(['type', 'description', 'expiresAt'])
          && isText(reward.description, 200);
    }

    // The party isn't stored on the reservation: it is the reservation's memberships in party_user.
    function isValidReservation(data) {
      return data.keys().hasAll(['questId', 'venueId', 'slotStart', 'status', 'createdAt',
              'explorerName'])
          && data.keys().hasOnly(['questId', 'venueId', 'slotStart', 'status', 'createdAt',
              'explorerName'])
          && data.questId is string
          && data.venueId is string
          && data.slotStart is timestamp
          && data.createdAt is timestamp
          && data.explorerName is string;
    }

    // [name] is the display name in the signed-in user's profile, so nobody reserves under another
    // name. Reads the same profile as hasRole, which rules count as one document read.
    function isOwnDisplayName(name) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          == name;
    }

    // [time] is now or later. The app sets a new reservation's slotStart from the phone's clock,
    // which can be a little behind the server's, so it may be up to 5 minutes earlier.
    function isNotInThePast(time) {
      return time >= request.time - duration.value(5, 'm');
    }

    // The reservation's quest exists, is active and belongs to the venue the reservation names.
    // Costs one document read.
    function isForActiveQuestOfItsVenue(data) {
      let quest = /databases/$(database)/documents/quests/$(data.questId);
      return exists(quest)
          && get(quest).data.status == 'ACTIVE'
          && get(quest).data.venueId == data.venueId;
    }

    // The schema's allowed status transitions for reservations.
    function isReservationTransition(from, to) {
      return (from == 'PENDING' && to in ['APPROVED', 'REJECTED', 'CANCELLED'])
          || (from == 'APPROVED' && to == 'CANCELLED');
    }

    function isValidPartyMember(data) {
      return data.keys().hasAll(['reservationId', 'uid', 'status', 'joinedAt', 'updatedAt'])
          && data.keys().hasOnly(['reservationId', 'uid', 'status', 'joinedAt', 'updatedAt'])
          && data.reservationId is string
          && data.uid is string
          && data.status in ['JOINED', 'WITHDRAWN']
          && data.joinedAt is timestamp
          && data.updatedAt is timestamp;
    }

    function reservation(reservationId) {
      return /databases/$(database)/documents/reservations/$(reservationId);
    }

    // The signed-in user's membership in the party of [reservationId]. Its id is built from the
    // reservation and the user, so checking it costs one document read.
    function ownMembership(reservationId) {
      return /databases/$(database)/documents/party_user/$(reservationId + '_' + request.auth.uid);
    }

    // The signed-in user is a joined member of the party of [reservationId].
    function isJoinedMember(reservationId) {
      return exists(ownMembership(reservationId))
          && get(ownMembership(reservationId)).data.status == 'JOINED';
    }

    // The signed-in user is a joined member of the party of [reservationId] once this write is
    // applied, e.g. through a membership created in the same batch.
    function willBeJoinedMember(reservationId) {
      return existsAfter(ownMembership(reservationId))
          && getAfter(ownMembership(reservationId)).data.status == 'JOINED';
    }

    // Only the owner reads their profile.
    // The role is write-once: it can be chosen while null, then never changed.
    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid) && isValidUser(request.resource.data);
      allow update: if isUser(uid)
          && isValidUser(request.resource.data)
          && (resource.data.get('role', null) == null
              || request.resource.data.get('role', null) == resource.data.role);
    }

    // One venue per account: the document id is the owner's uid, and the owner is a venue account.
    match /venues/{ownerUid} {
      allow read: if signedIn();
      allow create, update: if isUser(ownerUid)
          && hasRole('VENUE')
          && isValidVenue(request.resource.data);
      allow delete: if isUser(ownerUid) && hasRole('VENUE');
    }

    // venueId is the owning venue's uid and can't be reassigned.
    match /quests/{questId} {
      allow read: if signedIn();
      allow create: if isUser(request.resource.data.venueId)
          && hasRole('VENUE')
          && isValidQuest(request.resource.data);
      allow update: if isUser(resource.data.venueId)
          && request.resource.data.venueId == resource.data.venueId
          && hasRole('VENUE')
          && isValidQuest(request.resource.data);
      allow delete: if isUser(resource.data.venueId) && hasRole('VENUE');
    }

    // An explorer account creates a pending reservation, in one batch with their own joined
    // membership, that carries their profile's display name and doesn't start in the past, for an
    // active quest of the venue it names. Afterwards only the status changes, along an allowed
    // transition: the venue answers it, and a joined member of the party can cancel it. The venue
    // and the party's joined members read it. Anyone signed in may find that an id has no
    // reservation: the app listens to a reservation it just created, offline maybe, before the
    // server has it.
    match /reservations/{reservationId} {
      allow read: if signedIn()
          && (resource == null
              || request.auth.uid == resource.data.venueId
              || isJoinedMember(reservationId));
      allow create: if signedIn()
          && hasRole('EXPLORER')
          && isValidReservation(request.resource.data)
          && willBeJoinedMember(reservationId)
          && isOwnDisplayName(request.resource.data.explorerName)
          && request.resource.data.status == 'PENDING'
          && isNotInThePast(request.resource.data.slotStart)
          && isForActiveQuestOfItsVenue(request.resource.data);
      allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && isReservationTransition(resource.data.status, request.resource.data.status)
          && (request.auth.uid == resource.data.venueId
              || (isJoinedMember(reservationId) && request.resource.data.status == 'CANCELLED'));
    }

    // One membership per explorer and reservation, under the id `{reservationId}_{uid}`. An
    // explorer account joins a pending reservation as themselves; getAfter also sees a reservation
    // created in the same batch. Afterwards the member can only withdraw, which also moves
    // updatedAt, and never join again. The member, the party's other joined members and the
    // reservation's venue read it. Memberships are never deleted, so a withdrawal stays recorded.
    // A reservation that doesn't exist has no memberships, and anyone signed in may list them: the
    // app listens to the party of a reservation it just created before the server has it.
    match /party_user/{memberId} {
      allow read: if signedIn()
          && (request.auth.uid == resource.data.uid
              || isJoinedMember(resource.data.reservationId)
              || !exists(reservation(resource.data.reservationId))
              || request.auth.uid == get(reservation(resource.data.reservationId)).data.venueId);
      allow create: if signedIn()
          && hasRole('EXPLORER')
          && isValidPartyMember(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && memberId == request.resource.data.reservationId + '_' + request.auth.uid
          && request.resource.data.status == 'JOINED'
          && getAfter(reservation(request.resource.data.reservationId)).data.status == 'PENDING';
      allow update: if isUser(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasAll(['status', 'updatedAt'])
          && resource.data.status == 'JOINED'
          && request.resource.data.status == 'WITHDRAWN'
          && request.resource.data.updatedAt is timestamp;
    }

    // completions: no rules yet, so all access is denied until completions get a repository.
  }
}
