{
  "name": "around-functions",
  "description": "Cloud Functions for Around: the notifications sent when a reservation or a proof changes",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-project \"npm test\"",
    "test:coverage": "firebase emulators:exec --only firestore --project demo-project \"npm test -- --coverage\""
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
