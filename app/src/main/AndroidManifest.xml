<?xml version="1.0" encoding="utf-8"?>
<!-- Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com> -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The location repository needs one of these. Both are requested; the user may grant only the coarse one. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Proof photos. TakePicture opens the camera app, which works without this permission; once
         it is declared, Android only opens the camera after the explorer allows it, which gives
         the ask-first and refused states #330 asks for. Don't remove it as unused. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The connectivity repository reads the default network. Granted at install, never asked. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phones without a camera can still install the app and pick a proof from the gallery -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AroundApp"
        tools:targetApi="31">
        <!-- Filled from MAPS_API_KEY at build time; see app/build.gradle.kts -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- Older Play services without the current Maps renderer draw the map with Apache HTTP classes,
             which apps targeting Android 9+ only get on request: without this, the map crashes there -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
        <!-- Lets the camera app write a proof photo into the app's cache; see ProofPhotos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.proofphotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/proof_photo_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AroundApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>