    <string name="quest_detail_party_code">Party code</string>
    <string name="quest_detail_party_code_copy">Copy the party code</string>
    <string name="quest_detail_party_code_copied">Code copied</string>
    <string name="quest_detail_party_code_share">Share the code</string>
    <string name="quest_detail_party_code_hint">Friends enter it under Quests › Join a party.</string>
    <!-- What the share sheet sends: the quest's title, the venue's name and the code -->
    <string name="quest_detail_party_code_message">Join my party for “%1$s” at %2$s on Around! The party code is %3$s.</string>
    <string name="quest_detail_proof">Proof</string>
    <string name="quest_detail_proof_photo">A photo</string>
    <string name="quest_detail_proof_text">A text answer</string>
    <string name="quest_detail_proof_checked">The venue checks it, usually within a few minutes.</string>
    <!-- Where the explorer's proof stands, at the top of the quest's details -->
    <string name="quest_detail_proof_pending_label">Pending</string>
    <string name="quest_detail_proof_pending_title">Proof sent</string>
    <string name="quest_detail_proof_pending_text">%1$s is checking it, usually within a few minutes.</string>
    <!-- Instead of the two above, once another member of the party sent its proof -->
    <string name="quest_detail_proof_pending_title_by">%1$s sent your party\'s proof</string>
    <string name="quest_detail_proof_pending_text_by">%1$s is checking it, usually within a few minutes. Anyone in the party can send a new one until then.</string>
    <string name="quest_detail_proof_approved_label">Completed</string>
    <string name="quest_detail_proof_approved_title">Quest complete!</string>
    <string name="quest_detail_proof_approved_text">%1$s approved your proof. Your reward is ready.</string>
    <string name="quest_detail_proof_rejected_label">Rejected</string>
    <string name="quest_detail_proof_rejected_title">Proof not approved</string>
